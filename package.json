{
  "name": "express-post",
  "version": "1.0.0",
  "description": "ExpressPost - Premium Multithreaded API Client & Runner",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "build-win": "electron-builder --win --x64"
  },
  "dependencies": {
    "axios": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.expresspost",
    "productName": "ExpressPost",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "files": [
      "package.json",
      "server.js",
      "electron-main.js",
      "public/**/*"
    ],
    "asar": true
  }
}
